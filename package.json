{
  "name": "salem-local",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "salem": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:core": "tsc",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "test": "npm run build && node scripts/test.mjs",
    "test:ui": "playwright test",
    "salem": "node scripts/start-local.mjs",
    "doctor": "node dist/src/cli.js doctor --config profiles/demo.json",
    "package:windows": "node scripts/package-windows.mjs",
    "test:distribution": "node --test tests/public-export.test.mjs tests/windows-build-inputs.test.mjs tests/windows-package.test.mjs",
    "export:public": "node scripts/export-public.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "description": "Local software engineering supervisor for Claude Code and Codex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/88randy/Salem.git"
  },
  "bugs": {
    "url": "https://github.com/88randy/Salem/issues"
  },
  "homepage": "https://github.com/88randy/Salem#readme"
}
